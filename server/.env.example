# MongoDB connection string (MongoDB Atlas free tier works fine).
# Leave empty in local dev to use the in-memory store (data resets on restart).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo-app?retryWrites=true&w=majority

PORT=5000

# Comma-separated list of origins allowed to call the API (your Netlify URL).
# Leave empty to allow all origins (fine for local dev).
CORS_ORIGIN=https://your-site.netlify.app,http://localhost:5173
